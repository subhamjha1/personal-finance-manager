# Copy to .env (never commit .env). All values are optional for local H2 runs.
PORT=8080
# Local default is in-memory H2. For PostgreSQL set SPRING_PROFILES_ACTIVE=prod and the DB_* values below.
# SPRING_PROFILES_ACTIVE=prod
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=pfm
# DB_USERNAME=pfm
# DB_PASSWORD=change-me
# Set to true when served over HTTPS (forced true by the prod profile)
SESSION_COOKIE_SECURE=false
APP_TIMEZONE=UTC
